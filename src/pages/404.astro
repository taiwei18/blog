---
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: '404 · Nothing Here',
  description: 'The requested page has dissolved into void.',
  robots: 'noindex,follow',
  searchable: false
}
---

<PageLayout {frontmatter}>
  <div class="not-prose my-8 select-text sm:my-16" data-pagefind-ignore>
    <!-- 先锋杂志封面式布局网格：双栏非对称排印 -->
    <div
      class="relative border-t-2 border-b-2 border-[var(--text-title)] py-12 sm:py-20"
    >
      <!-- 极小上标序列编号 -->
      <div
        class="text-muted hairline-bottom mb-8 flex items-center justify-between pb-4 font-mono text-xs tracking-widest uppercase"
      >
        <div class="flex items-center gap-3">
          <span class="text-title font-bold">404</span>
          <span>·</span>
          <span>PAGE NOT FOUND</span>
        </div>
        <div class="text-faint hidden items-center gap-4 sm:flex">
          <span>STATIC ARCHIVE</span>
        </div>
      </div>

      <!-- 巨型先锋排版焦点 -->
      <div class="grid grid-cols-1 items-baseline gap-8 lg:grid-cols-12">
        <!-- 左侧：超大衬线/等宽混合数字 -->
        <div class="select-none lg:col-span-7">
          <div
            class="text-title font-serif text-8xl leading-none tracking-tighter italic sm:text-9xl"
          >
            Void.
          </div>
          <div
            class="text-muted mt-4 flex items-start gap-2 font-mono text-xs tracking-widest uppercase"
          >
            <span
              class="mt-2 inline-block h-px w-6 shrink-0 bg-[var(--text-title)] sm:w-8"
            ></span>
            <span class="min-w-0 break-words"
              >ERROR CODE: HTTP_404_PAGE_MISSING</span
            >
          </div>
        </div>

        <!-- 右侧：先锋杂志导读块与哲学阐述 -->
        <div class="flex flex-col justify-between font-sans lg:col-span-5">
          <div>
            <p
              class="text-title mb-4 font-serif text-lg leading-snug italic sm:text-xl"
            >
              “The page you are looking for has been moved, archived, or never
              existed in this dimension.”
            </p>
            <p class="text-muted mb-8 font-sans text-sm leading-relaxed">
              你访问的路径在博客路由拓扑中处于未定义状态。它也许曾作为草稿存在，或在某次架构重构中归于虚无。
            </p>
          </div>

          <!-- 先锋单线操作区 -->
          <div class="flex flex-col gap-3 font-mono text-xs">
            <a
              href="/"
              data-astro-prefetch
              class="group border-border-subtle bg-surface text-title hover:border-title flex items-center justify-between border px-3 py-2.5 no-underline transition-all"
            >
              <span class="flex items-center gap-2">
                <span
                  class="text-muted group-hover:text-title transition-colors"
                  >01</span
                >
                <span class="font-sans font-medium">返回主页</span>
              </span>
              <span class="transition-transform group-hover:translate-x-1"
                >→</span
              >
            </a>

            <a
              href="/search/"
              data-astro-prefetch
              class="group border-border-subtle text-muted hover:border-title hover:text-title flex items-center justify-between border bg-transparent px-3 py-2.5 no-underline transition-all"
            >
              <span class="flex items-center gap-2">
                <span
                  class="text-faint group-hover:text-muted transition-colors"
                  >02</span
                >
                <span class="font-sans font-medium">检索站点归档</span>
              </span>
              <span class="transition-transform group-hover:translate-x-1"
                >↗</span
              >
            </a>

            <button
              id="editorial-back"
              type="button"
              class="group text-muted hover:border-border-subtle hover:text-title flex items-center justify-between border border-transparent bg-transparent px-3 py-2.5 text-left transition-all"
            >
              <span class="flex items-center gap-2">
                <span
                  class="text-faint group-hover:text-muted transition-colors"
                  >03</span
                >
                <span class="font-sans font-medium">退回上个页面</span>
              </span>
              <span
                class="text-faint group-hover:text-muted font-mono text-[10px]"
                >ESC</span
              >
            </button>
          </div>
        </div>
      </div>

      <!-- 底部脚注：纯粹的杂志元信息条 -->
      <div
        class="hairline-top text-muted mt-12 flex flex-col justify-between gap-3 pt-6 font-mono text-[11px] sm:flex-row sm:items-center"
      >
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <span class="text-faint">$</span>
          <span>REQUEST:</span>
          <span
            id="editorial-path"
            class="text-title min-w-0 font-medium break-all">/</span
          >
        </div>
        <div class="text-faint flex items-center gap-4">
          <span>HTTP_STATUS: 404</span>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  function setupEditorial404() {
    const pathEl = document.getElementById('editorial-path')
    if (pathEl) {
      pathEl.textContent = window.location.pathname || '/'
    }

    const backBtn = document.getElementById('editorial-back')
    if (backBtn) {
      backBtn.addEventListener('click', () => {
        if (window.history.length > 1) {
          window.history.back()
        } else {
          window.location.href = '/'
        }
      })
    }
  }

  setupEditorial404()
  document.addEventListener('astro:page-load', setupEditorial404)

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (window.history.length > 1) {
        window.history.back()
      } else {
        window.location.href = '/'
      }
    }
  })
</script>
