---
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: '关于',
  description:
    'TaiWei 的开发实践、技术栈与工具记录，涵盖服务端、Web 应用与 AI 辅助开发。',
  activeHeaderLink: '关于'
}
---

<PageLayout {frontmatter}>
  <div class="not-prose about-container flex flex-col gap-12 sm:gap-16">
    <!-- Hero Title & Identity -->
    <section data-about-hero data-entrance class="flex flex-col gap-5 pt-2">
      <div class="flex flex-col gap-4">
        <h1
          class="text-title flex flex-wrap items-baseline gap-3 text-4xl font-semibold tracking-[-0.05em] sm:text-6xl"
        >
          <span id="scramble-name" class="cursor-default font-sans select-none"
            >TAIWEI</span
          >
        </h1>
        <p
          id="scramble-tagline"
          class="text-body max-w-xl text-base leading-relaxed sm:text-lg"
        >
          围绕实际需求做开发，记录业务功能、接口服务与 Web
          应用的实现过程。也探索 AI 工具在编码、调试与重构中的用法。
        </p>
      </div>

      <div
        class="text-muted flex flex-wrap items-center gap-x-6 gap-y-2 pt-2 font-mono text-xs"
      >
        <span>Role: Software Developer</span>
        <span class="text-border-medium hidden sm:inline">/</span>
        <span>Focus: Software Development & Engineering Practice</span>
      </div>
    </section>

    <!-- Spacious Card 1: Core Principles -->
    <section class="flex flex-col gap-4">
      <div
        class="border-border-subtle flex items-center justify-between border-b pb-3 font-mono text-xs"
      >
        <h2 class="text-title font-sans text-base font-semibold tracking-tight">
          开发中的一些原则
        </h2>
        <span class="text-muted font-mono text-xs tracking-wider uppercase"
          >Axioms</span
        >
      </div>

      <div
        data-spotlight
        data-entrance
        data-entrance-order="1"
        class="spotlight-card flex flex-col gap-8 p-6 sm:p-10"
      >
        <div
          class="border-border-subtle text-muted flex items-center justify-between border-b pb-4 font-mono text-xs"
        >
          <span class="text-accent font-medium tracking-wider uppercase"
            >DEVELOPMENT PRINCIPLES</span
          >
          <span class="text-faint font-mono text-xs">CORE</span>
        </div>

        <div class="divide-border-subtle/60 flex flex-col gap-8 divide-y">
          <div
            class="flex flex-col items-start justify-between gap-3 pt-0 sm:flex-row sm:items-baseline sm:gap-6"
          >
            <div class="flex shrink-0 items-center gap-3 sm:w-48">
              <span class="text-accent font-mono text-sm font-semibold"
                >01.</span
              >
              <h3 class="text-title font-sans text-base font-semibold">
                可扩展性
              </h3>
            </div>
            <div class="flex-1">
              <p
                class="text-accent/80 mb-1 font-mono text-xs tracking-wider uppercase"
              >
                Extensibility
              </p>
              <p class="text-muted text-sm leading-relaxed">
                划清模块职责与依赖边界，让新需求能在现有结构上逐步扩展，减少对已有逻辑的改动，也避免为不确定的未来过度设计。
              </p>
            </div>
          </div>

          <div
            class="flex flex-col items-start justify-between gap-3 pt-6 sm:flex-row sm:items-baseline sm:gap-6"
          >
            <div class="flex shrink-0 items-center gap-3 sm:w-48">
              <span class="text-accent font-mono text-sm font-semibold"
                >02.</span
              >
              <h3 class="text-title font-sans text-base font-semibold">
                可复用性
              </h3>
            </div>
            <div class="flex-1">
              <p
                class="text-accent/80 mb-1 font-mono text-xs tracking-wider uppercase"
              >
                Reusability
              </p>
              <p class="text-muted text-sm leading-relaxed">
                从重复的业务场景中提炼通用能力，通过清晰的接口与合理的抽象复用代码，减少重复实现，也保留不同场景的灵活性。
              </p>
            </div>
          </div>

          <div
            class="flex flex-col items-start justify-between gap-3 pt-6 sm:flex-row sm:items-baseline sm:gap-6"
          >
            <div class="flex shrink-0 items-center gap-3 sm:w-48">
              <span class="text-accent font-mono text-sm font-semibold"
                >03.</span
              >
              <h3 class="text-title font-sans text-base font-semibold">
                可读性
              </h3>
            </div>
            <div class="flex-1">
              <p
                class="text-accent/80 mb-1 font-mono text-xs tracking-wider uppercase"
              >
                Readability
              </p>
              <p class="text-muted text-sm leading-relaxed">
                用准确的命名、直接的逻辑与必要的注释表达意图，让代码容易理解，方便协作、排查问题与后续维护。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Development Stack & Tools -->
    <section class="flex flex-col gap-4">
      <div
        class="border-border-subtle flex items-center justify-between border-b pb-3 font-mono text-xs"
      >
        <h2 class="text-title font-sans text-base font-semibold tracking-tight">
          技术栈与工具链
        </h2>
        <span class="text-muted font-mono text-xs tracking-wider uppercase"
          >Stack & Tools</span
        >
      </div>

      <div
        data-spotlight
        data-entrance
        data-entrance-order="2"
        class="spotlight-card flex flex-col gap-8 p-6 sm:p-10"
      >
        <div class="grid grid-cols-1 gap-8 sm:gap-10 md:grid-cols-2">
          <!-- Column 1: Backend Development -->
          <div class="flex flex-col justify-between gap-5">
            <div class="flex flex-col gap-2">
              <span
                class="text-accent font-mono text-xs tracking-wider uppercase"
                >BACKEND & BUSINESS LOGIC</span
              >
              <h3
                class="text-title font-sans text-base font-semibold sm:text-lg"
              >
                服务端与业务开发
              </h3>
              <p class="text-muted text-xs leading-relaxed sm:text-sm">
                使用 Node.js、PHP、Java
                等技术实现业务功能与接口服务，关注业务建模、数据处理、性能与日常维护。
              </p>
            </div>
            <div class="flex flex-wrap gap-2.5 pt-2">
              {
                ['Node.js', 'PHP', 'Java'].map((tech) => (
                  <span class="border-border-subtle bg-surface text-title hover:border-accent hover:text-accent border px-3 py-1.5 font-mono text-xs">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Column 2: Web Applications & Developer Tools -->
          <div class="flex flex-col justify-between gap-5">
            <div class="flex flex-col gap-2">
              <span
                class="text-accent font-mono text-xs tracking-wider uppercase"
                >WEB & DEVELOPER TOOLS</span
              >
              <h3
                class="text-title font-sans text-base font-semibold sm:text-lg"
              >
                Web 应用与开发工具
              </h3>
              <p class="text-muted text-xs leading-relaxed sm:text-sm">
                结合 TypeScript、Vue、React 等工具完成 Web 应用开发，也使用
                Claude Code、Codex 等 AI 工具辅助编码、排查问题与整理工程流程。
              </p>
            </div>
            <div class="flex flex-wrap gap-2.5 pt-2">
              {
                [
                  'TypeScript',
                  'Vue 3',
                  'React',
                  'Astro',
                  'Vite',
                  'Claude Code',
                  'Codex CLI'
                ].map((tool) => (
                  <span class="border-border-subtle bg-surface text-title hover:border-accent hover:text-accent border px-3 py-1.5 font-mono text-xs">
                    {tool}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dossier Card: Engineering Preferences & Manifesto -->
    <section class="flex flex-col gap-4">
      <div
        class="border-border-subtle flex items-center justify-between border-b pb-3 font-mono text-xs"
      >
        <h2 class="text-title font-sans text-base font-semibold tracking-tight">
          工程手记与配置
        </h2>
        <span class="text-muted font-mono text-xs tracking-wider uppercase"
          >Engineering Notes</span
        >
      </div>

      <div
        data-entrance
        data-entrance-order="4"
        class="terminal-window flex flex-col gap-5 p-5 sm:p-8"
      >
        <!-- Titlebar & Tabs -->
        <div
          class="border-border-subtle flex flex-wrap items-center justify-between gap-3 border-b pb-4"
        >
          <div class="text-muted flex items-center gap-2 font-mono text-xs">
            <span class="text-accent font-semibold">sys://dossier</span>
            <span class="text-faint">/</span>
            <span>engineering-spec</span>
          </div>
          <!-- Tabs -->
          <div
            class="flex max-w-full items-center gap-1.5 overflow-x-auto font-mono text-xs"
          >
            <button
              data-term-tab="manifesto"
              class="terminal-tab active border-accent bg-accent/10 text-accent shrink-0 cursor-pointer border px-2.5 py-1"
            >
              manifesto.md
            </button>
            <button
              data-term-tab="specs"
              class="terminal-tab text-muted hover:text-title shrink-0 cursor-pointer border border-transparent px-2.5 py-1"
            >
              toolchain.json
            </button>
            <button
              data-term-tab="log"
              class="terminal-tab text-muted hover:text-title shrink-0 cursor-pointer border border-transparent px-2.5 py-1"
            >
              principles.log
            </button>
          </div>
        </div>

        <!-- Content Panels -->
        <div
          id="term-panel-manifesto"
          class="terminal-content text-body min-h-[140px] font-sans text-sm leading-relaxed"
        >
          <p class="text-muted leading-relaxed">
            开发从理解问题开始，也离不开实现之后的维护与迭代。<br />
            选择技术时，先看业务需要，再考虑团队协作和长期成本。<br /><br />
            希望在每一次实践中做到：<br />
            <span class="text-title font-medium"
              >逻辑清楚，接口可靠，代码易读，问题可追踪。</span
            >
          </p>
        </div>

        <div
          id="term-panel-specs"
          class="terminal-content text-body hidden min-h-[140px] overflow-x-auto font-mono text-xs leading-relaxed sm:text-sm"
        >
          <pre
            class="text-muted"><code class="text-muted"><span class="text-accent">&#123;</span>
  <span class="text-title">"author"</span>: <span class="text-accent">"TaiWei"</span>,
  <span class="text-title">"backend"</span>: <span class="text-accent">["Node.js", "PHP", "Java"]</span>,
  <span class="text-title">"web"</span>: <span class="text-accent">["TypeScript", "Vue 3", "React", "Astro"]</span>,
  <span class="text-title">"tools"</span>: <span class="text-accent">["Vite", "Claude Code", "Codex CLI"]</span>,
  <span class="text-title">"focus"</span>: <span class="text-accent">["Business Logic", "API Design", "Maintainability"]</span>
<span class="text-accent">&#125;</span></code></pre>
        </div>

        <div
          id="term-panel-log"
          class="terminal-content text-body flex hidden min-h-[140px] flex-col gap-2 font-mono text-xs leading-loose sm:text-sm"
        >
          <div class="terminal-line text-muted">
            [DEV] 从需求出发，让业务逻辑与模块职责清楚可读。
          </div>
          <div class="terminal-line text-muted">
            [API] 明确接口约定，认真处理输入校验、错误反馈与数据一致性。
          </div>
          <div class="terminal-line text-muted">
            [DEBUG] 用测试与日志验证行为，让问题能够复现和定位。
          </div>
          <div class="terminal-line text-accent font-semibold">
            [TOOLS] 让工具服务于开发，在实践中检验 AI 辅助编码的效果。
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  let cleanup = () => {}

  const setupAboutInteractions = () => {
    cleanup()
    const controller = new AbortController()
    const { signal } = controller
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

    // 1. Text Scramble Animation
    const scramble = (
      element: HTMLElement,
      originalText: string,
      duration = 0.8
    ) => {
      if (reduced.matches) {
        element.textContent = originalText
        return
      }
      const chars = '0123456789ABCDEF!<>-_\\/[]{}~=+*^?#'
      const steps = Math.floor(duration * 30)
      let step = 0
      let timer: number | undefined = undefined
      timer = window.setInterval(() => {
        step++
        const progress = step / steps
        element.textContent = originalText
          .split('')
          .map((char, index) => {
            if (char === ' ') return ' '
            if (index / originalText.length < progress) return char
            return chars[Math.floor(Math.random() * chars.length)]
          })
          .join('')

        if ((reduced.matches || step >= steps) && timer !== undefined) {
          window.clearInterval(timer)
          element.textContent = originalText
        }
      }, 1000 / 30)

      signal.addEventListener('abort', () => {
        if (timer !== undefined) window.clearInterval(timer)
        element.textContent = originalText
      })
    }

    const nameEl = document.querySelector<HTMLElement>('#scramble-name')
    if (nameEl) {
      const nameText = nameEl.textContent?.trim() || 'TAIWEI'
      scramble(nameEl, nameText, 0.9)
    }

    // 3. Spotlight 指针追踪由全局 Motion.astro 统一处理

    // 4. Terminal Tabs Switching
    const tabs = document.querySelectorAll<HTMLButtonElement>('.terminal-tab')
    const panels = {
      log: document.querySelector<HTMLElement>('#term-panel-log'),
      specs: document.querySelector<HTMLElement>('#term-panel-specs'),
      manifesto: document.querySelector<HTMLElement>('#term-panel-manifesto')
    }

    tabs.forEach((tab) => {
      tab.addEventListener(
        'click',
        () => {
          const target = tab.dataset.termTab as keyof typeof panels
          if (!target || !panels[target]) return

          tabs.forEach((t) => {
            t.classList.remove(
              'active',
              'border-accent',
              'bg-accent/10',
              'text-accent'
            )
            t.classList.add('border-transparent', 'text-muted')
          })
          tab.classList.add(
            'active',
            'border-accent',
            'bg-accent/10',
            'text-accent'
          )
          tab.classList.remove('border-transparent', 'text-muted')

          Object.values(panels).forEach((p) => p?.classList.add('hidden'))
          panels[target]?.classList.remove('hidden')
        },
        { signal }
      )
    })

    // 5. 入场动画由全局 Motion.astro 通过 data-entrance 统一处理

    cleanup = () => {
      controller.abort()
    }
  }

  document.addEventListener('astro:page-load', setupAboutInteractions)
  document.addEventListener('astro:before-swap', () => cleanup())
</script>
