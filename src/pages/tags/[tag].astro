---
import PostsList from '@/components/posts/PostsList.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import { getPosts } from '@/util/posts'
import { generateTags } from '@/util/tags'
import type { InferGetStaticPropsType } from 'astro'

const {
  tag: { tag }
} = Astro.props

type Props = InferGetStaticPropsType<typeof getStaticPaths>

export async function getStaticPaths() {
  const tags = await generateTags()

  return tags.map(({ tag, icon }) => ({
    params: { tag },
    props: { tag: { tag, icon } }
  }))
}

const posts = await getPosts(tag)

const frontmatter: PageLayoutProps['frontmatter'] = {
  title: `标签：${tag}`,
  description: `浏览 TaiWei 关于 ${tag} 的 ${posts.length} 篇技术文章与工程实践记录。`,
  activeHeaderLink: '标签'
}
---

<PageLayout {frontmatter}>
  <div slot="top" data-entrance data-entrance-order="1" class="mb-8">
    <a
      href="/tags/"
      data-magnetic
      class="group text-muted hover:text-title inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <span
        class="iconify tabler--arrow-left text-sm transition-transform duration-200 group-hover:-translate-x-0.5"
      ></span>
      <span>所有标签</span>
    </a>
  </div>

  <div data-entrance data-entrance-order="2" class="hairline-bottom mb-10 pb-4">
    <h1
      class="text-title font-sans text-2xl font-semibold tracking-tight sm:text-3xl"
    >
      #{tag}
    </h1>
    <p class="text-muted mt-1 font-mono text-xs">
      收录 <span data-counter-target={posts.length}>{posts.length}</span> 篇文章
    </p>
  </div>

  <div class="not-prose">
    <PostsList {posts} />
  </div>
</PageLayout>
