---
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import BaseLayout, {
  type Props as BaseLayoutProps
} from '@/layouts/BaseLayout.astro'
import { getPosts } from '@/util/posts'
import { toDateString } from '@/util'

export type Props = BaseLayoutProps & {
  frontmatter: { showLatestPost?: boolean }
}

const { frontmatter } = Astro.props

const allPosts = await getPosts()
const recentPosts = allPosts.slice(0, 6)
---

<BaseLayout frontmatter={frontmatter}>
  <div class="flex min-h-screen flex-col">
    <Header activeHeaderLink="首页" />

    <main
      id="main"
      class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-5 pt-24 sm:px-6 sm:pt-28 md:px-0"
    >
      <section class="editorial-hero" aria-labelledby="hero-title">
        <div class="hero-kicker" data-entrance>
          <span class="hero-imprint">TaiWei’s journal</span>
          <span class="hero-kicker-rule" aria-hidden="true"></span>
          <span class="hero-category">技术 · 实践 · 思考</span>
        </div>

        <h1 id="hero-title" class="hero-title">
          <span class="hero-line-mask">
            <span data-title-line class="hero-title-line">深入技术，</span>
          </span>
          <span class="hero-line-mask hero-line-offset">
            <span data-title-line class="hero-title-line"
              >浅出<span class="hero-emphasis"
                >文字<span class="hero-period">。</span></span
              ></span
            >
          </span>
        </h1>

        <div class="hero-colophon" data-entrance data-entrance-order="1">
          <p class="hero-description">
            在代码与原理之间，留下一些思考。<br />
            把复杂的事，慢慢写清楚。
          </p>
          <a href="/about/" class="hero-about hero-link">
            <span>关于 TaiWei</span>
            <svg
              class="hero-arrow"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path d="M5 19 19 5M5 5h14v14"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Articles Section -->
      <section class="mb-20">
        <div
          class="border-border-subtle mb-2 flex items-end justify-between border-b pb-4 font-mono"
        >
          <h2 class="text-title font-sans text-xl font-medium tracking-tight">
            精选文章
          </h2>
          <a
            href="/posts/"
            data-magnetic
            class="group text-muted hover:text-title inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
          >
            <span>查看全部 ({allPosts.length})</span>
            <span
              class="border-border-subtle bg-surface text-muted group-hover:border-accent group-hover:text-accent flex size-3.5 items-center justify-center border font-mono text-[9px] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0.5"
              aria-hidden="true">→</span
            >
          </a>
        </div>

        <div class="flex flex-col">
          {
            recentPosts.map((post, index) => (
              <article
                data-reveal
                class="post-row group border-border-subtle border-b py-6 sm:py-7"
              >
                <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <a
                    href={`/posts/${post.id}/`}
                    class="interactive-underline text-title inline-flex items-start gap-2.5 text-base font-medium tracking-tight no-underline sm:text-lg"
                    data-astro-prefetch
                  >
                    <span class="text-accent mt-1 font-mono text-xs font-normal opacity-70 transition-opacity group-hover:opacity-100">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span>{post.data.title}</span>
                    <span
                      aria-hidden="true"
                      class="post-arrow border-border-subtle bg-surface/80 text-accent mt-1 flex size-4 shrink-0 items-center justify-center border text-[10px] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
                    >
                      <span class="iconify tabler--arrow-up-right text-[11px]" />
                    </span>
                  </a>
                  <time
                    class="text-muted shrink-0 font-mono text-xs tabular-nums"
                    datetime={post.data.publishedDate.toISOString()}
                  >
                    {toDateString(post.data.publishedDate)}
                  </time>
                </div>
                <p class="text-muted mt-3 line-clamp-2 max-w-xl pl-6 text-xs leading-relaxed sm:pl-7 sm:text-sm">
                  {post.data.description}
                </p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .editorial-hero {
    --hero-ink: var(--text-title);
    padding-top: clamp(1rem, 3vw, 2.25rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  :global([data-mode='light']) .editorial-hero {
    --hero-ink: var(--text-title);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
  }

  .hero-imprint {
    flex-shrink: 0;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.0625rem;
    font-style: italic;
    letter-spacing: 0;
  }

  .hero-kicker-rule {
    width: 2.5rem;
    height: 1px;
    background: var(--border-medium);
  }

  .hero-category {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
  }

  .hero-title {
    margin-block: 2.75rem 2.5rem;
    color: var(--text-title);
    font-family:
      'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', 'SimSun', serif;
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.045em;
  }

  .hero-line-mask {
    display: block;
    overflow: hidden;
  }

  .hero-title-line {
    display: block;
    white-space: nowrap;
  }

  .hero-line-offset {
    margin-left: 1.5em;
  }

  .hero-emphasis {
    color: var(--hero-ink);
  }

  .hero-period {
    margin-left: -0.12em;
  }

  .hero-colophon {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero-description {
    margin: 0;
    color: var(--text-body);
    font-size: 0.8125rem;
    line-height: 2;
    letter-spacing: 0.035em;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-title);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      color 220ms ease,
      transform 220ms var(--ease-surface);
  }

  .hero-link:is(:hover, :focus-visible) {
    color: var(--hero-ink);
  }

  .hero-link:focus-visible {
    outline-color: var(--hero-ink);
  }

  .hero-link:active {
    transform: translateY(1px);
  }

  .hero-about {
    flex-shrink: 0;
    gap: 1rem;
    color: var(--text-body);
  }

  .hero-arrow {
    flex-shrink: 0;
    transition: transform 300ms var(--ease-surface);
  }

  .hero-about:is(:hover, :focus-visible) .hero-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 479px) {
    .hero-title {
      margin-block: 2.25rem 1.75rem;
    }

    .hero-colophon {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
