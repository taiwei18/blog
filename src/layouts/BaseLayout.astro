---
import '@/style/main.css'
import '@fontsource/geist-sans/latin-400.css'
import '@fontsource/geist-sans/latin-500.css'
import '@fontsource/geist-sans/latin-600.css'
import '@fontsource/geist-mono/latin-400.css'
import '@fontsource/newsreader/latin-400-italic.css'
import geistSans400 from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url'
import geistSans500 from '@fontsource/geist-sans/files/geist-sans-latin-500-normal.woff2?url'

import AmbientBackground from '@/components/AmbientBackground.astro'
import Motion from '@/components/Motion.astro'
import ModeManager from '@/components/mode/ModeManager.astro'
import CodeBlockIconsPlugin from '@/plugins/CodeBlockIconsPlugin.astro'
import config from '@/theme.config'
import { resolveImageUrl } from '@/util'
import type { ImageMetadata } from 'astro'
import { ClientRouter } from 'astro:transitions'

export interface Props {
  frontmatter: Partial<{
    title: string
    author: string
    description: string
    canonicalURL: string
    openGraphImage: string | ImageMetadata
    openGraphType: 'website' | 'article'
    robots: string
    publishedDate: Date
    updatedDate: Date
    tags: string[]
    keywords: string[]
    structuredData:
      | Record<string, unknown>
      | Array<Record<string, unknown>>
  }>
}

const {
  frontmatter: {
    title = config.title,
    author = config.author,
    description = config.description,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    openGraphImage = config.openGraphImage || '/ogImage.png',
    openGraphType = 'website',
    robots = 'index,follow',
    publishedDate,
    updatedDate
  }
} = Astro.props

let titleWithSuffix = title

if (String(title).toLowerCase() !== String(config.title).toLowerCase())
  titleWithSuffix += ` - ${config.title}`

const openGraphImageUrl = new URL(resolveImageUrl(openGraphImage), Astro.site).href
const openGraphImageAlt = `${titleWithSuffix} Cover`
const articleAuthorUrl = new URL(`/authors/${encodeURIComponent(author)}/`, Astro.site).href

const frontmatterTags = Array.isArray(Astro.props.frontmatter?.tags) ? Astro.props.frontmatter.tags : []
const frontmatterKeywords = Array.isArray(Astro.props.frontmatter?.keywords) ? Astro.props.frontmatter.keywords : []
const keywords = frontmatterKeywords.length ? frontmatterKeywords : frontmatterTags
const keywordsContent = keywords.length ? keywords.join(', ') : undefined

const structuredDataEntries = Array.isArray(Astro.props.frontmatter?.structuredData)
  ? Astro.props.frontmatter.structuredData
  : Astro.props.frontmatter?.structuredData
  ? [Astro.props.frontmatter.structuredData]
  : []
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.title,
  url: config.site,
  description: config.description,
  inLanguage: config.locale
}
const structuredDataJson = JSON.stringify([siteStructuredData, ...structuredDataEntries])
---

<!doctype html>
<html lang={config.locale} class={config.colorScheme || 'scheme-mono'}>
  <head>
    <meta charset="utf-8" />
    <!-- 首帧前标记可执行入场动效，配合 main.css 先隐藏入场元素，避免内容闪现后再淡入 -->
    <script is:inline>
      ;(() => {
        if (window.__motionReady) return
        window.__motionReady = true
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
        const apply = () => document.documentElement.classList.toggle('motion-ready', !reduced.matches)
        apply()
        // 页面切换时 Astro 会用新文档覆盖 <html> 的属性，需要在新页面渲染前重新标记
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    <link rel="preload" href={geistSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistSans500} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{titleWithSuffix}</title>
    <meta name="title" content={titleWithSuffix} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    <meta name="robots" content={robots} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang={config.locale} href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={title} href={new URL('feed.xml', Astro.site)} />

    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={titleWithSuffix} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:alt" content={openGraphImageAlt} />
    <meta property="og:locale" content={config.locale.replace('-', '_')} />
    <meta property="og:site_name" content={config.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleWithSuffix} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImageUrl} />

    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <ModeManager />
    <ClientRouter />
    <link href="/zoom-vanilla.js/zoom.css" rel="stylesheet" />
  </head>
  <body class="relative min-h-screen">
    <AmbientBackground />
    <Motion />
    <slot />
    <CodeBlockIconsPlugin />
    <script is:inline data-astro-rerun src="/zoom-vanilla.js/zoom-vanilla.min.js"></script>
  </body>
</html>
