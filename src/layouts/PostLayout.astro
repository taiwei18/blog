---
import AdjacentPostsBar from '@/components/AdjacentPostsBar.astro'
import TagsBar from '@/components/TagsBar.astro'
import ToC from '@/components/ToC.astro'
import PageLayout, {
  type Props as PageLayoutProps
} from '@/layouts/PageLayout.astro'
import HeadingAnchorsPlugin from '@/plugins/HeadingAnchorsPlugin.astro'
import { resolveImageUrl, toDateString } from '@/util'
import { resolveTags } from '@/util/tags'
import { render, type CollectionEntry } from 'astro:content'
import config from '@/theme.config'

export interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props

const {
  Content,
  remarkPluginFrontmatter: { readingTime, wordCount },
  headings
} = await render(post)

const canonicalURL = new URL(
  post.data.canonicalURL || Astro.url.pathname,
  Astro.site
).href
const authorURL = new URL(
  `/authors/${encodeURIComponent(post.data.author)}/`,
  Astro.site
).href
const openGraphImage = post.data.openGraphImage || `/posts/${post.id}.png`
const openGraphImageUrl = new URL(resolveImageUrl(openGraphImage), Astro.site)
  .href
const dateModified = post.data.updatedDate || post.data.publishedDate

const frontmatter: PageLayoutProps['frontmatter'] = {
  ...post.data,
  canonicalURL,
  openGraphImage,
  openGraphType: 'article',
  updatedDate: dateModified,
  activeHeaderLink: '博客',
  scrollProgress: true
}

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: canonicalURL,
  datePublished: post.data.publishedDate.toISOString(),
  dateModified: dateModified.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: authorURL
  },
  publisher: {
    '@type': 'Person',
    name: config.author,
    url: new URL('/about/', Astro.site).href
  },
  image: {
    '@type': 'ImageObject',
    url: openGraphImageUrl,
    width: 1200,
    height: 630
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL
  },
  keywords: post.data.tags,
  articleSection: post.data.tags[0],
  wordCount,
  inLanguage: config.locale
}

frontmatter.structuredData = articleStructuredData
frontmatter.keywords = [post.data.title, ...post.data.tags]
---

<PageLayout {frontmatter}>
  <div slot="top" data-entrance data-entrance-order="1" class="mb-10">
    <a
      href="/posts/"
      data-magnetic
      class="group text-muted hover:text-title inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <span
        class="iconify tabler--arrow-left text-sm transition-transform duration-200 group-hover:-translate-x-0.5"
      ></span>
      <span>cd ..</span>
    </a>
  </div>

  <!-- 杂志与工坊式文章标题排印 -->
  <header
    data-entrance
    data-entrance-order="2"
    class="hairline-bottom mb-12 pb-8"
  >
    <div class="text-muted mb-4 flex items-center gap-3 font-mono text-xs">
      <time datetime={post.data.publishedDate.toISOString()}>
        {toDateString(post.data.publishedDate)}
      </time>
      <span>·</span>
      <span>{readingTime}</span>
      {
        wordCount && (
          <>
            <span>·</span>
            <span>{wordCount} 字</span>
          </>
        )
      }
    </div>

    <h1
      class="text-title mb-6 font-sans text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl md:text-4xl"
    >
      {frontmatter.title}
    </h1>

    <div class="flex flex-wrap items-center gap-2">
      <TagsBar tags={resolveTags(post.data.tags)} />
    </div>
  </header>

  {
    !!post.data.showToC && headings.length >= 2 && (
      <div slot="aside" class="border-border-subtle border-l py-1 pl-4">
        <div class="text-muted mb-3.5 flex items-center gap-1.5 font-mono text-[11px] tracking-widest uppercase">
          <span
            class="iconify tabler--list-tree text-accent text-xs"
            aria-hidden="true"
          />
          <span>On this page</span>
        </div>
        <ToC {headings} />
      </div>
    )
  }

  {
    !!post.data.showToC && headings.length >= 2 && (
      <div class="2xl:hidden">
        <ToC {headings} isInline />
      </div>
    )
  }

  <article
    data-pagefind-body
    data-pagefind-filter="type:post"
    class="prose text-body max-w-none font-sans text-base leading-relaxed"
  >
    <Content />
  </article>

  <AdjacentPostsBar {post} slot="bottom" />
  <HeadingAnchorsPlugin />
</PageLayout>
