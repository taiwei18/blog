<!--
  页面切换：抓取新页面的同时，旧页面的内容区（[data-page-exit]）先带短模糊退场；
  顶栏、背景不参与退场，新旧快照完全一致，根节点交叉淡化时它们纹丝不动。
  新页面的内容由 Motion.astro 的入场动画接管，与交叉淡化同时开始。
-->
<script>
  const EXIT_DURATION = 150

  let exits: Animation[] = []

  document.addEventListener('astro:before-preparation', (event) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

    const regions = document.querySelectorAll<HTMLElement>('[data-page-exit]')
    if (!regions.length) return

    // 快速连点时上一次退场还在（或已停在终点）：直接沿用，不让内容闪回
    if (!exits.length) {
      exits = Array.from(regions, (region) =>
        region.animate(
          [
            reduced.matches
              ? { opacity: 1 }
              : { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' },
            reduced.matches
              ? { opacity: 0 }
              : {
                  opacity: 0,
                  transform: 'translateY(-12px)',
                  filter: 'blur(4px)'
                }
          ],
          {
            duration: EXIT_DURATION,
            easing: 'ease-out',
            fill: 'forwards'
          }
        )
      )
    }

    // Run the short exit alongside the next page's network request.
    const finished = Promise.allSettled(exits.map((a) => a.finished))
    const originalLoader = event.loader
    event.loader = async () => {
      await Promise.all([originalLoader(), finished])
    }
  })

  // 旧元素已随换页移除，清空引用
  document.addEventListener('astro:after-swap', () => {
    exits = []
  })
  // 请求失败时 Astro 会退回整页跳转；从往返缓存返回这一页时把内容还原
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return
    exits.forEach((animation) => animation.cancel())
    exits = []
  })
</script>

<style is:global>
  /* 根节点交叉淡化：比浏览器默认的 250ms 更短，入场动画才是主角 */
  html[data-astro-transition]::view-transition-old(root),
  html[data-astro-transition]::view-transition-new(root) {
    animation-duration: 200ms;
  }
</style>
