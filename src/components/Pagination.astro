---
import type { Page } from 'astro'

export interface Props {
  page: Page
}

const { page } = Astro.props

const normalizePageUrl = (url: string) => {
  const normalized = url === '/posts/1' ? '/posts/' : `${url}/`
  return normalized.replace(/\/+/g, '/')
}
---

{
  page.lastPage > 1 && (
    <nav
      data-reveal
      class="border-border-subtle mb-8 flex w-full grow items-end justify-center border-t pt-6"
    >
      <div class="flex items-center gap-4 font-mono text-xs">
        {page.url.prev ? (
          <a
            data-magnetic
            class="group text-muted hover:text-accent inline-flex items-center gap-1 transition-colors"
            href={normalizePageUrl(page.url.prev)}
          >
            <span
              aria-hidden="true"
              class="transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-x-0.5"
            >
              ←
            </span>
            Previous
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Previous
          </span>
        )}
        <span class="tabular-nums">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next ? (
          <a
            data-magnetic
            class="group text-muted hover:text-accent inline-flex items-center gap-1 transition-colors"
            href={normalizePageUrl(page.url.next)}
          >
            Next
            <span
              aria-hidden="true"
              class="transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-0.5"
            >
              →
            </span>
          </a>
        ) : (
          <span class="opacity-25" aria-disabled="true">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}
