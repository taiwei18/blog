---
import { toDateString } from '@/util'
import type { CollectionEntry } from 'astro:content'

export interface Props {
  post: CollectionEntry<'posts'>
}

const { id, data } = Astro.props.post
---

<article data-reveal class="post-row group py-6 first:pt-0 last:pb-0">
  <div
    class="mb-2 flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline sm:gap-4"
  >
    <a
      class="interactive-underline text-title inline-flex items-center gap-2 font-sans text-lg font-medium no-underline"
      href={`/posts/${id}/`}
      data-astro-prefetch
    >
      <span>{data.title}</span>
      <span
        aria-hidden="true"
        class="post-arrow border-border-subtle bg-surface/80 text-accent flex size-4 shrink-0 items-center justify-center border text-[10px] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
      >
        <span class="iconify tabler--arrow-up-right text-[11px]"></span>
      </span>
    </a>
    <time
      class="text-muted shrink-0 font-mono text-xs tabular-nums"
      datetime={data.publishedDate.toISOString()}
    >
      {toDateString(data.publishedDate)}
    </time>
  </div>

  <p class="text-body line-clamp-2 font-sans text-sm leading-relaxed">
    {data.description}
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    {
      data.tags.map((tag: string) => (
        <a
          href={`/tags/${tag}/`}
          class="text-muted hover:text-title hover:bg-surface-hover px-1.5 py-0.5 font-mono text-xs transition-colors"
        >
          #{tag}
        </a>
      ))
    }
  </div>
</article>
