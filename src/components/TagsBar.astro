---
import type { ResolvedTag } from '@/types'

export interface Props {
  tags: ResolvedTag[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-1.5 text-xs">
  {
    tags.map(({ tag }) => {
      return (
        <a
          class="text-muted hover:text-accent font-mono text-[0.68rem] transition-colors duration-150"
          href={`/tags/${tag}/`}
        >
          #{tag}
        </a>
      )
    })
  }
</div>
