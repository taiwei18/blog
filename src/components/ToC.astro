---
interface Heading {
  depth: number
  slug: string
  text: string
}

export interface Props {
  headings: Heading[]
  isInline?: boolean
  class?: string
}

const { headings, isInline = false, class: className = '' } = Astro.props

const filteredHeadings = (headings || []).filter(
  (h) => h.depth === 2 || h.depth === 3
)

let h2Counter = 0
const processedHeadings = filteredHeadings.map((h) => {
  if (h.depth === 2) {
    h2Counter++
    return { ...h, indexStr: String(h2Counter).padStart(2, '0') }
  }
  return { ...h, indexStr: '·' }
})
---

{
  processedHeadings.length > 0 &&
    (isInline ? (
      <nav
        aria-label="文章导览目录"
        class={`toc-inline not-prose border-border-subtle bg-surface/50 mb-8 rounded-[2px] border p-4 sm:mb-10 sm:p-5 ${className}`}
      >
        <div class="border-border-subtle/80 flex items-center justify-between border-b pb-2.5 font-mono text-xs">
          <div class="text-title flex items-center gap-2 font-medium">
            <span
              class="iconify tabler--list-tree text-accent text-sm"
              aria-hidden="true"
            />
            <span>文章导览</span>
            <span class="text-faint text-[11px] font-normal">/ Contents</span>
          </div>
          <span class="text-muted font-mono text-[11px] tabular-nums">
            {processedHeadings.length} 节
          </span>
        </div>

        <ul class="mt-3.5 space-y-1.5 font-sans text-xs">
          {processedHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-4 sm:pl-5' : ''}>
              <a
                href={`#${h.slug}`}
                class="group text-muted hover:text-title line-clamp-1 inline-flex items-baseline gap-2 py-0.5 no-underline transition-colors"
              >
                <span class="text-faint group-hover:text-accent shrink-0 font-mono text-[10px] tabular-nums transition-colors">
                  {h.indexStr}
                </span>
                <span class="leading-relaxed transition-transform duration-150 group-hover:translate-x-0.5">
                  {h.text}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav
        aria-label="页面大纲目录"
        class={`toc-aside not-prose font-sans text-xs select-none ${className}`}
      >
        <ul class="relative space-y-1">
          <span class="toc-indicator" data-visible="false" aria-hidden="true" />
          {processedHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-3' : ''}>
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                class="toc-aside-link text-muted hover:bg-surface-hover hover:text-title relative z-[1] line-clamp-2 block rounded-[2px] px-2.5 py-1 text-[12px] leading-relaxed no-underline transition-[color,background-color,box-shadow] duration-200"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
}

<style is:global>
  .toc-aside-link.is-active {
    color: var(--accent) !important;
    font-weight: 500 !important;
  }

  /* 液态高亮条：与顶栏指示条同一套手法，上下两条边各走一条弹簧，
     前沿（滚动方向那一侧）先到，后沿跟上，跨越多个标题时会被拉长 */
  .toc-indicator {
    position: absolute;
    z-index: 0;
    right: 0;
    border-radius: 2px;
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
    opacity: 0;
    pointer-events: none;
    transition:
      top var(--edge-top-duration, 0ms) var(--spring-snappy),
      bottom var(--edge-bottom-duration, 0ms) var(--spring-snappy),
      left 420ms var(--spring-snappy),
      opacity 200ms ease;
  }

  .toc-indicator[data-visible='true'] {
    opacity: 1;
  }
</style>

<script>
  function setupTocScrollSpy() {
    const asideLinks =
      document.querySelectorAll<HTMLAnchorElement>('.toc-aside-link')
    if (asideLinks.length === 0) return

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]')
    )
    if (headings.length === 0) return

    const controller = new AbortController()
    const { signal } = controller

    let activeSlug = ''
    const indicator = document.querySelector<HTMLElement>('.toc-indicator')
    let edgeTop: number | null = null

    const moveIndicator = (link: HTMLElement | undefined) => {
      if (!indicator || !link) return
      const list = indicator.parentElement
      if (!list) return

      const top = link.offsetTop
      const bottom = list.clientHeight - top - link.offsetHeight
      const appearing = edgeTop === null
      const direction = appearing ? 0 : Math.sign(top - (edgeTop as number))

      indicator.style.setProperty(
        '--edge-top-duration',
        appearing ? '0ms' : direction < 0 ? '420ms' : '640ms'
      )
      indicator.style.setProperty(
        '--edge-bottom-duration',
        appearing ? '0ms' : direction > 0 ? '420ms' : '640ms'
      )
      indicator.style.top = `${top}px`
      indicator.style.bottom = `${bottom}px`
      indicator.style.left = `${link.offsetLeft}px`
      indicator.dataset.visible = 'true'
      edgeTop = top
    }

    const updateActiveHeading = () => {
      const scrollPosition = window.scrollY + 120 // Header height offset
      let currentHeading: HTMLElement | null = null

      for (const h of headings) {
        if (h.offsetTop <= scrollPosition) {
          currentHeading = h
        } else {
          break
        }
      }

      const slug = currentHeading ? currentHeading.id : headings[0]?.id || ''
      if (slug === activeSlug) return
      activeSlug = slug

      asideLinks.forEach((link) => {
        if (link.dataset.tocSlug === slug) {
          link.classList.add('is-active')
          moveIndicator(link)
          link.scrollIntoView({ block: 'nearest', inline: 'nearest' })
        } else {
          link.classList.remove('is-active')
        }
      })
    }

    // 目录宽度变化（字体加载、窗口缩放）会改变换行和高度：直接贴合，不做动画
    const list = indicator?.parentElement
    const resizeObserver = new ResizeObserver(() => {
      edgeTop = null
      moveIndicator(
        Array.from(asideLinks).find(
          (link) => link.dataset.tocSlug === activeSlug
        )
      )
    })
    if (list) resizeObserver.observe(list)
    signal.addEventListener('abort', () => resizeObserver.disconnect())

    let frame = 0
    const scheduleUpdate = () => {
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        updateActiveHeading()
      })
    }

    window.addEventListener('scroll', scheduleUpdate, {
      passive: true,
      signal
    })
    updateActiveHeading()

    return () => {
      controller.abort()
      cancelAnimationFrame(frame)
    }
  }

  let cleanupSpy: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    cleanupSpy?.()
    cleanupSpy = setupTocScrollSpy()
  })

  document.addEventListener('astro:before-swap', () => {
    cleanupSpy?.()
    cleanupSpy = undefined
  })
</script>
