---
interface Heading {
  depth: number
  slug: string
  text: string
}

export interface Props {
  headings: Heading[]
  isInline?: boolean
  class?: string
}

const { headings, isInline = false, class: className = '' } = Astro.props

const filteredHeadings = (headings || []).filter(
  (h) => h.depth === 2 || h.depth === 3
)

let h2Counter = 0
const processedHeadings = filteredHeadings.map((h) => {
  if (h.depth === 2) {
    h2Counter++
    return { ...h, indexStr: String(h2Counter).padStart(2, '0') }
  }
  return { ...h, indexStr: '·' }
})
---

{
  processedHeadings.length > 0 && (
    isInline ? (
      <nav
        aria-label="文章导览目录"
        class={`toc-inline not-prose mb-8 sm:mb-10 rounded-[2px] border border-border-subtle bg-surface/50 p-4 sm:p-5 ${className}`}
      >
        <div class="flex items-center justify-between border-b border-border-subtle/80 pb-2.5 font-mono text-xs">
          <div class="flex items-center gap-2 font-medium text-title">
            <span class="iconify tabler--list-tree text-accent text-sm" aria-hidden="true" />
            <span>文章导览</span>
            <span class="text-faint font-normal text-[11px]">/ Contents</span>
          </div>
          <span class="font-mono text-[11px] text-muted tabular-nums">
            {processedHeadings.length} 节
          </span>
        </div>

        <ul class="mt-3.5 space-y-1.5 text-xs font-sans">
          {processedHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-4 sm:pl-5' : ''}>
              <a
                href={`#${h.slug}`}
                class="group inline-flex items-baseline gap-2 py-0.5 text-muted transition-colors hover:text-title no-underline line-clamp-1"
              >
                <span class="font-mono text-[10px] text-faint group-hover:text-accent transition-colors tabular-nums shrink-0">
                  {h.indexStr}
                </span>
                <span class="group-hover:translate-x-0.5 transition-transform duration-150 leading-relaxed">
                  {h.text}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav
        aria-label="页面大纲目录"
        class={`toc-aside not-prose font-sans text-xs select-none ${className}`}
      >
        <ul class="space-y-1">
          {processedHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-3' : ''}>
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                class="toc-aside-link block rounded-[2px] px-2.5 py-1 text-[12px] leading-relaxed text-muted transition-[color,background-color,box-shadow] duration-200 hover:bg-surface-hover hover:text-title no-underline line-clamp-2"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  )
}

<style is:global>
  .toc-aside-link {
    box-shadow: inset 0 0 0 transparent;
  }

  /* 左侧细条随激活项渐入，配合背景色过渡，滚动时高亮不再硬跳 */
  .toc-aside-link.is-active {
    color: var(--accent) !important;
    font-weight: 500 !important;
    background-color: color-mix(in oklab, var(--accent) 10%, transparent) !important;
    box-shadow: inset 2px 0 0 var(--accent);
  }
</style>

<script>
  function setupTocScrollSpy() {
    const asideLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-aside-link')
    if (asideLinks.length === 0) return

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]')
    )
    if (headings.length === 0) return

    const controller = new AbortController()
    const { signal } = controller

    let activeSlug = ''

    const updateActiveHeading = () => {
      const scrollPosition = window.scrollY + 120 // Header height offset
      let currentHeading: HTMLElement | null = null

      for (const h of headings) {
        if (h.offsetTop <= scrollPosition) {
          currentHeading = h
        } else {
          break
        }
      }

      const slug = currentHeading ? currentHeading.id : headings[0]?.id || ''
      if (slug === activeSlug) return
      activeSlug = slug

      asideLinks.forEach((link) => {
        if (link.dataset.tocSlug === slug) {
          link.classList.add('is-active')
          link.scrollIntoView({ block: 'nearest', inline: 'nearest' })
        } else {
          link.classList.remove('is-active')
        }
      })
    }

    let frame = 0
    const scheduleUpdate = () => {
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        updateActiveHeading()
      })
    }

    window.addEventListener('scroll', scheduleUpdate, {
      passive: true,
      signal
    })
    updateActiveHeading()

    return () => {
      controller.abort()
      cancelAnimationFrame(frame)
    }
  }

  let cleanupSpy: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    cleanupSpy?.()
    cleanupSpy = setupTocScrollSpy()
  })

  document.addEventListener('astro:before-swap', () => {
    cleanupSpy?.()
    cleanupSpy = undefined
  })
</script>
