---
import HeaderItem from '@/components/layout/HeaderItem.astro'
import type { NavItemParent } from '@/types'
import { generateItemId } from '@/util'

export interface Props {
  item: NavItemParent
  activeHeaderLink?: string
}

const {
  item: { children, icon, label },
  activeHeaderLink
} = Astro.props

const isActive = children.some(
  (item) => activeHeaderLink === item.label || activeHeaderLink === item.href
)

const instanceId = crypto.randomUUID()
const buttonId = generateItemId(`${label}-${instanceId}-button`)
const menuId = generateItemId(`${label}-${instanceId}-menu`)
---

<dropdown-parent
  class="relative block sm:inline-block"
  data-open="false"
  data-is-active={String(isActive)}
>
  <button
    id={buttonId}
    aria-haspopup="true"
    aria-controls={menuId}
    aria-expanded="false"
    class:list={[
      'group relative flex items-center gap-1 py-1.5 text-xs tracking-tight transition-colors duration-200 select-none sm:w-auto sm:py-1',
      { 'text-title font-medium': isActive },
      { 'text-muted hover:text-title': !isActive }
    ]}
  >
    {
      icon && (
        <span
          class={`iconify text-sm transition-transform duration-200 group-hover:-translate-y-0.5 ${icon}`}
        />
      )
    }
    <span class="relative">
      {label}
    </span>
    <span
      aria-hidden="true"
      class="iconify tabler--chevron-down ml-1 text-xs opacity-60 transition-transform duration-200 ease-out group-hover:translate-y-0.5 group-hover:opacity-100"
    ></span>
  </button>

  <ul
    id={menuId}
    role="menu"
    aria-labelledby={buttonId}
    hidden
    inert
    class="dropdown-surface border-border-subtle bg-surface/95 mt-1.5 w-full flex-col gap-0.5 rounded-[2px] border p-1 shadow-xl shadow-black/10 backdrop-blur-xl sm:absolute sm:right-0 sm:z-30 sm:mt-2.5 sm:w-auto sm:min-w-[140px]"
  >
    {
      children.map((item) => (
        <li
          role="none"
          class="hover:bg-card-hover rounded-[2px] transition-colors duration-150"
        >
          <div class="px-2.5 py-1">
            <HeaderItem
              role="menuitem"
              {item}
              isActive={
                activeHeaderLink === item.label ||
                activeHeaderLink === item.href
              }
            />
          </div>
        </li>
      ))
    }
  </ul>
</dropdown-parent>

<script>
  class Dropdown extends HTMLElement {
    private controller?: AbortController
    private animation?: Animation

    disconnectedCallback() {
      this.controller?.abort()
      this.animation?.cancel()
    }

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const button = this.querySelector('button')
      const menu = this.querySelector('ul')

      if (!button || !menu) return

      const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'))
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
      reduced.addEventListener(
        'change',
        () => {
          this.animation?.cancel()
          menu.hidden = this.dataset.open !== 'true'
        },
        { signal }
      )
      const setOpen = (open: boolean, focus = false) => {
        this.animation?.cancel()
        this.dataset.open = String(open)
        button.setAttribute('aria-expanded', String(open))
        menu.inert = !open
        if (!open && menu.contains(document.activeElement)) button.focus()
        if (open) menu.hidden = false
        if (reduced.matches) {
          menu.hidden = !open
        } else {
          this.animation = menu.animate(
            open
              ? [
                  { opacity: 0, transform: 'translateY(-6px)' },
                  { opacity: 1, transform: 'translateY(0)' }
                ]
              : [
                  { opacity: 1, transform: 'translateY(0)' },
                  { opacity: 0, transform: 'translateY(-4px)' }
                ],
            {
              duration: open ? 220 : 150,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
            }
          )
          this.animation.onfinish = () => {
            menu.hidden = !open
          }
        }
        if (open && focus) items[0]?.focus()
      }

      button.addEventListener(
        'click',
        (event) => {
          setOpen(this.dataset.open !== 'true', event.detail === 0)
        },
        { signal }
      )

      this.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && this.dataset.open === 'true') {
            event.preventDefault()
            event.stopPropagation()
            setOpen(false)
            button.focus()
          }
          if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
            event.preventDefault()
            if (this.dataset.open !== 'true') setOpen(true)
            const current = items.indexOf(
              document.activeElement as HTMLAnchorElement
            )
            const next =
              event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? items.length - 1
                  : event.key === 'ArrowDown'
                    ? (current + 1) % items.length
                    : current < 0
                      ? items.length - 1
                      : (current - 1 + items.length) % items.length
            items[next]?.focus()
          }
        },
        { signal }
      )

      document.addEventListener(
        'click',
        (event) => {
          if (
            !this.contains(event.target as Node) &&
            this.dataset.open === 'true'
          )
            setOpen(false)
        },
        { signal }
      )
      this.addEventListener(
        'focusout',
        (event) => {
          if (
            !this.contains(event.relatedTarget as Node) &&
            this.dataset.open === 'true'
          )
            setOpen(false)
        },
        { signal }
      )
    }
  }

  if (!customElements.get('dropdown-parent'))
    customElements.define('dropdown-parent', Dropdown)
</script>
