<mobile-nav-toggle>
  <button
    class="group border-border-subtle bg-surface/50 text-title hover:border-border-medium hover:bg-card-hover flex size-9 items-center justify-center border transition-all duration-200 active:scale-95"
    title="Toggle mobile nav"
    aria-label="打开导航菜单"
    aria-controls="mobile-nav"
    aria-expanded="false"
  >
    <span aria-hidden="true" class="menu-glyph"></span>
  </button>
</mobile-nav-toggle>

<script>
  class MobileNavToggle extends HTMLElement {
    private controller?: AbortController

    disconnectedCallback() {
      this.controller?.abort()
    }

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const nav = document.querySelector<HTMLElement>('#mobile-nav')
      const button = this.querySelector('button')

      if (!nav || !button) return

      const navIsOpen = () => nav.dataset.open === 'true'

      const close = () => {
        if (nav.contains(document.activeElement)) button.focus()
        nav.dataset.open = 'false'
        nav.inert = true
        nav.setAttribute('aria-hidden', 'true')
        button.setAttribute('aria-label', '打开导航菜单')
        button.setAttribute('aria-expanded', 'false')
      }

      const open = () => {
        nav.dataset.open = 'true'
        nav.inert = false
        nav.setAttribute('aria-hidden', 'false')
        button.setAttribute('aria-label', '关闭导航菜单')
        button.setAttribute('aria-expanded', 'true')
      }

      const handleToggle = () => {
        if (navIsOpen()) close()
        else open()
      }

      button.addEventListener('click', handleToggle, { signal })
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && navIsOpen()) {
            close()
            button.focus()
          }
        },
        { signal }
      )
      document.addEventListener(
        'click',
        (event) => {
          if (
            navIsOpen() &&
            !nav.contains(event.target as Node) &&
            !this.contains(event.target as Node)
          )
            close()
        },
        { signal }
      )
      window
        .matchMedia('(min-width: 640px)')
        .addEventListener('change', () => close(), { signal })
    }
  }

  if (!customElements.get('mobile-nav-toggle'))
    customElements.define('mobile-nav-toggle', MobileNavToggle)
</script>
