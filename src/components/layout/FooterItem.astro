---
import type { NavItem } from '@/types'
import { isAbsolute } from '@/util'

export interface Props {
  item: NavItem
  static?: boolean
}

const {
  item: { href, icon, label },
  static: isStatic = false
} = Astro.props
---

<a
  class="press-feedback hover:border-border-medium hover:text-accent flex size-11 items-center justify-center border border-transparent text-current/80"
  data-static={isStatic || undefined}
  href={href}
  target={isAbsolute(href) ? '_blank' : '_self'}
  aria-label={label}
  rel="noopener noreferrer"
>
  <span title={label} class={`iconify text-2xl ${icon}`}></span>
</a>
