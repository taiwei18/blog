---
import ModeToggle from "@/components/mode/ModeToggle.astro";
import config from "@/theme.config";
import type {
  HeaderItem as HeaderItemType,
  NavItem as NavItemType,
} from "@/types";

export interface Props {
  activeHeaderLink?: string;
}

const { activeHeaderLink } = Astro.props;

const isNavItem = (item: HeaderItemType): item is NavItemType =>
  Object.hasOwn(item, "href");

const primaryNavLinks = config.navbarItems.flatMap((item) =>
  isNavItem(item) ? [item] : [],
);
const desktopNavLinks = primaryNavLinks.filter((item) => item.href !== "/");
const utilityNavLinks = config.navbarItems.flatMap((item) =>
  isNavItem(item) ? [] : item.children,
);
const isActive = (item: NavItemType) =>
  activeHeaderLink === item.label || activeHeaderLink === item.href;
---

<!-- Progressive Blur Top Shelf: 滚动时在页面顶部呈现平滑的多阶渐进式毛玻璃过渡 -->
<div
  id="progressive-blur-shelf"
  class="progressive-blur-shelf pointer-events-none fixed inset-x-0 top-0 z-30"
  aria-hidden="true"
>
  <div class="blur-step blur-step-1"></div>
  <div class="blur-step blur-step-2"></div>
  <div class="blur-step blur-step-3"></div>
  <div class="blur-gradient"></div>
</div>

<header
  id="site-header"
  class="site-header pointer-events-none fixed inset-x-0 top-5 z-40 w-full px-5 lg:px-10"
>
  <a
    href="#main"
    class="focus:bg-title focus:text-canvas pointer-events-auto sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-5 focus:z-50 focus:px-3 focus:py-2 focus:font-mono focus:text-xs"
  >
    跳到正文
  </a>

  <nav
    id="site-island"
    class="site-island pointer-events-auto mx-auto w-full"
    aria-label="主导航"
  >
    <div class="flex h-[3.375rem] items-center justify-between px-4 sm:px-6">
      <a
        href="/"
        class="brand-link group text-title flex shrink-0 items-center gap-2.5 focus-visible:outline-none"
        transition:name="branding"
        aria-label={`${config.title} 首页`}
      >
        <svg
          viewBox="0 0 32 32"
          class="size-5 overflow-visible"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M4 7h24M16 7v18M6 15l5 10 5-9 5 9 5-10"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="16" cy="16" r="1.2" fill="currentColor"></circle>
        </svg>
        <span
          class="text-sm font-semibold tracking-[-0.035em] sm:text-[0.9375rem]"
        >
          {config.title}
        </span>
      </a>

      <div class="flex min-w-0 items-center gap-1 sm:gap-2">
        <div class="nav-desktop-cluster hidden items-center md:flex">
          <div class="nav-primary flex items-center">
            {
              desktopNavLinks.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item) ? "page" : undefined}
                  class:list={[
                    "nav-primary-link relative block px-3 py-2 text-[0.8125rem] tracking-[-0.02em] transition-opacity duration-200 focus-visible:outline-none",
                    isActive(item)
                      ? "text-title"
                      : "text-muted hover:text-title",
                  ]}
                >
                  <span>{item.label}</span>
                </a>
              ))
            }
          </div>

          <span class="bg-border-subtle mx-1 block h-4 w-px" aria-hidden="true"
          ></span>

          <a
            href="/search/"
            class="nav-control text-muted hover:text-title flex size-9 items-center justify-center focus-visible:outline-none"
            aria-label="搜索全站文章"
            title="搜索全站文章"
          >
            <span class="iconify tabler--search text-[0.9375rem]"></span>
          </a>

          {
            config.modeToggle && (
              <div class="nav-mode-toggle block">
                <ModeToggle />
              </div>
            )
          }
        </div>

        <button
          id="menu-toggle-btn"
          type="button"
          class="nav-control menu-toggle-btn group text-title flex size-9 items-center justify-center focus-visible:outline-none"
          aria-expanded="false"
          aria-controls="studio-drawer"
          aria-label="打开网站菜单"
        >
          <span class="studio-hamburger" aria-hidden="true">
            <span class="line line-1"></span>
            <span class="line line-2"></span>
          </span>
        </button>
      </div>
    </div>

    <div
      id="studio-drawer"
      class="studio-drawer"
      data-open="false"
      aria-hidden="true"
      inert
    >
      <div class="drawer-inner">
        <div
          class="drawer-content border-border-subtle border-t px-4 pt-5 pb-6 sm:px-6 sm:pt-7 sm:pb-7"
        >
          <div class="drawer-menu">
            <p class="drawer-caption drawer-reveal" style="--i: 0">Menu</p>
            <div class="mt-2 flex flex-col items-start sm:mt-3">
              {
                primaryNavLinks.map((item, index) => (
                  <a
                    style={`--i: ${index + 1}`}
                    href={item.href}
                    aria-current={isActive(item) ? "page" : undefined}
                    class:list={[
                      "drawer-main-link drawer-reveal group relative w-fit text-[clamp(1.85rem,4vw,3.75rem)] leading-[0.95] tracking-[-0.055em] transition-opacity duration-200 focus-visible:outline-none",
                      isActive(item)
                        ? "text-title"
                        : "text-title/76 hover:text-title",
                    ]}
                  >
                    <span>{item.label}</span>
                    {isActive(item) && (
                      <span class="sr-only">（当前页面）</span>
                    )}
                  </a>
                ))
              }
            </div>
          </div>

          <div
            class="drawer-meta border-border-subtle mt-8 grid gap-7 border-t pt-5 sm:mt-10 sm:grid-cols-12 sm:gap-6 sm:pt-6"
          >
            <div class="drawer-reveal sm:col-span-4" style={`--i: ${primaryNavLinks.length + 1}`}>
              <p class="drawer-caption">Explore</p>
              <div class="text-title mt-2 flex flex-col items-start text-sm">
                <a class="drawer-small-link" href="/search/">全站搜索</a>
                <a
                  class="drawer-small-link"
                  href="/feed.xml"
                  target="_blank"
                  rel="noopener noreferrer">RSS 订阅</a
                >
                {
                  config.modeToggle && (
                    <div class="nav-mode-toggle mt-2.5 inline-flex items-center gap-2">
                      <span class="text-muted text-xs leading-none select-none tracking-tight">显示模式</span>
                      <ModeToggle />
                    </div>
                  )
                }
              </div>
            </div>

            <div class="drawer-reveal sm:col-span-4" style={`--i: ${primaryNavLinks.length + 2}`}>
              <p class="drawer-caption">Elsewhere</p>
              <div class="text-title mt-2 flex flex-col items-start text-sm">
                {
                  utilityNavLinks.map((item) => (
                    <a class="drawer-small-link" href={item.href}>{item.label}</a>
                  ))
                }
              </div>
            </div>

            <div class="drawer-reveal hidden sm:col-span-4 sm:block" style={`--i: ${primaryNavLinks.length + 3}`}>
              <p class="drawer-caption">Journal</p>
              <p class="text-muted mt-2 max-w-[18rem] text-sm leading-relaxed">
                {config.description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  let cleanupNavigation = () => {};

  const setupNavigation = () => {
    cleanupNavigation();

    const controller = new AbortController();
    const { signal } = controller;
    const island = document.querySelector<HTMLElement>("#site-island");
    const button =
      document.querySelector<HTMLButtonElement>("#menu-toggle-btn");
    const drawer = document.querySelector<HTMLElement>("#studio-drawer");
    const blurShelf = document.querySelector<HTMLElement>(
      "#progressive-blur-shelf",
    );
    const desktopCluster = island?.querySelector<HTMLElement>(
      ".nav-desktop-cluster",
    );

    if (!island || !button || !drawer) return;

    const desktopMedia = window.matchMedia("(min-width: 768px)");
    const isOpen = () => drawer.dataset.open === "true";
    let lastShelfOpacity = "";
    const syncNavigationState = () => {
      const scrollY = window.scrollY;
      const scrolled = scrollY > 20;
      island.classList.toggle("island-scrolled", scrolled);

      if (blurShelf) {
        // 随上下滑动连续平滑渐进：0~36px 之间平滑过渡；只在数值变化时写入
        const opacity = Math.min(1, Math.max(0, scrollY / 36)).toFixed(3);
        if (opacity !== lastShelfOpacity) {
          lastShelfOpacity = opacity;
          blurShelf.style.opacity = opacity;
        }
      }

      // inert 每次赋值都会写属性并触发样式重算，只在状态变化时更新
      const inert = desktopMedia.matches && (scrolled || isOpen());
      if (desktopCluster && desktopCluster.inert !== inert)
        desktopCluster.inert = inert;
    };

    let frame = 0;
    const scheduleSync = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        syncNavigationState();
      });
    };

    const setOpen = (open: boolean) => {
      drawer.dataset.open = String(open);
      drawer.inert = !open;
      drawer.setAttribute("aria-hidden", String(!open));
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "关闭网站菜单" : "打开网站菜单");
      island.toggleAttribute("data-drawer-open", open);
      syncNavigationState();
    };

    button.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();
        setOpen(!isOpen());
      },
      { signal },
    );

    document.addEventListener(
      "click",
      (event) => {
        if (isOpen() && !island.contains(event.target as Node)) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && isOpen()) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });

    const handleBreakpointChange = () => {
      if (desktopMedia.matches) setOpen(false);
      else syncNavigationState();
    };

    syncNavigationState();
    desktopMedia.addEventListener("change", handleBreakpointChange, { signal });
    window.addEventListener("scroll", scheduleSync, {
      passive: true,
      signal,
    });

    cleanupNavigation = () => {
      controller.abort();
      cancelAnimationFrame(frame);
    };
  };

  document.addEventListener("astro:page-load", setupNavigation);
  document.addEventListener("astro:before-swap", (event) => {
    cleanupNavigation();

    // 把当前导航条的收起状态带到新页面：新页面先以相同外观出现，
    // 页面加载后再按新的滚动位置平滑过渡，切页时不会出现两种宽度的导航条交叠。
    const oldIsland = document.querySelector("#site-island");
    const oldShelf = document.querySelector<HTMLElement>("#progressive-blur-shelf");
    const newIsland = event.newDocument.querySelector("#site-island");
    const newShelf = event.newDocument.querySelector<HTMLElement>("#progressive-blur-shelf");
    if (oldIsland?.classList.contains("island-scrolled"))
      newIsland?.classList.add("island-scrolled");
    if (oldShelf && newShelf) newShelf.style.opacity = oldShelf.style.opacity;
  });
</script>
