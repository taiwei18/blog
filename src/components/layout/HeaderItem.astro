---
import type { NavItem } from '@/types'
import { isAbsolute } from '@/util'
import type { JSX } from 'astro/jsx-runtime'

export interface Props {
  item: NavItem
  isActive?: boolean
  role?: JSX.AriaRole
}

const {
  isActive = false,
  item: { href, icon, label },
  role
} = Astro.props
---

<a
  href={href}
  class={`group/nav relative inline-flex items-center gap-1.5 py-1 text-xs tracking-tight transition-[color,opacity] duration-200 select-none ${
    isActive ? 'text-title font-medium' : 'text-muted hover:text-title'
  }`}
  target={isAbsolute(href) ? '_blank' : '_self'}
  {role}
>
  {
    icon && (
      <span
        class={`iconify text-sm transition-transform duration-200 group-hover/nav:scale-110 ${icon}`}
      />
    )
  }
  <span class="wrapper relative flex items-center">
    {label}
  </span>
  <span
    aria-hidden="true"
    class={`h-1 w-1 rounded-full bg-title transition-all duration-300 ease-out sm:inline-block ${
      isActive
        ? 'opacity-100 scale-100 shadow-[0_0_6px_rgba(0,0,0,0.3)] dark:shadow-[0_0_8px_rgba(255,255,255,0.4)]'
        : 'opacity-0 scale-50 group-hover/nav:opacity-40 group-hover/nav:scale-75'
    }`}></span>
</a>
