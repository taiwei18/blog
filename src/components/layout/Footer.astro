---
import FooterItem from '@/components/layout/FooterItem.astro'
import config from '@/theme.config'

const currentYear = new Date().getFullYear()
---

<footer
  class="mt-auto w-full pt-10 pb-[max(2rem,env(safe-area-inset-bottom))] transition-colors duration-300 sm:pt-14 sm:pb-12"
>
  <div
    class="border-border-subtle mx-auto flex max-w-2xl flex-col items-start justify-between gap-4 border-t px-5 pt-5 sm:flex-row sm:items-center sm:px-6 md:px-0"
  >
    <div class="text-muted font-mono text-xs">
      &#169; {currentYear}
      {config.author}
    </div>

    <div class="text-muted flex flex-wrap items-center gap-2 font-mono text-xs">
      {config.footerItems.map((item) => <FooterItem {item} />)}
    </div>
  </div>
</footer>
