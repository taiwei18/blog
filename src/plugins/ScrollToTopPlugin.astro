<scroll-top-button
  id="scroll-to-top"
  class="pointer-events-none fixed right-5 bottom-5 z-40 opacity-0 transition-opacity duration-150 sm:right-8 sm:bottom-8"
  inert
>
  <button
    type="button"
    class="press-feedback border-border-medium bg-surface/90 text-title hover:border-accent hover:text-accent flex size-10 cursor-pointer items-center justify-center rounded-[2px] border shadow-lg shadow-black/10 backdrop-blur-md"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <span aria-hidden="true" class="iconify tabler--arrow-up text-lg"></span>
  </button>
</scroll-top-button>

<script>
  let cleanup = () => {}

  function setupScrollToTop() {
    cleanup()
    const container = document.getElementById('scroll-to-top')
    if (!container) return
    const button = container.querySelector<HTMLButtonElement>('button')
    if (!button) return

    const controller = new AbortController()
    const { signal } = controller
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')

    let isVisible = false

    const isBelowViewport = () => {
      const minHeight = window.innerHeight * 0.4
      const scrollTop =
        document.documentElement.scrollTop || document.body.scrollTop
      return scrollTop > minHeight
    }

    const updateVisibility = () => {
      const shouldShow = isBelowViewport()
      if (shouldShow === isVisible) return
      isVisible = shouldShow

      container.style.opacity = isVisible ? '1' : '0'
      container.style.pointerEvents = isVisible ? 'auto' : 'none'
      container.inert = !isVisible
    }

    button.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: reduced.matches ? 'instant' : 'smooth'
        })
      },
      { signal }
    )

    let frame = 0
    const scheduleVisibility = () => {
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        updateVisibility()
      })
    }

    window.addEventListener('scroll', scheduleVisibility, {
      passive: true,
      signal
    })
    updateVisibility()

    cleanup = () => {
      controller.abort()
      cancelAnimationFrame(frame)
    }
  }

  document.addEventListener('astro:page-load', setupScrollToTop)
  document.addEventListener('astro:before-swap', () => cleanup())
</script>
