<scroll-top-button
  id="scroll-to-top"
  class="pointer-events-none fixed right-5 bottom-5 z-40 opacity-0 sm:right-8 sm:bottom-8"
>
  <button
    data-magnetic
    class="group border-border-medium bg-surface/90 text-title hover:border-accent hover:text-accent flex size-10 cursor-pointer items-center justify-center rounded-[2px] border shadow-lg shadow-black/10 backdrop-blur-md transition-[color,border-color,scale] duration-200 active:scale-95"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <span
      aria-hidden="true"
      class="iconify tabler--arrow-up text-lg transition-transform duration-200 ease-out group-hover:-translate-y-0.5"
    ></span>
  </button>
</scroll-top-button>

<script>
  import { gsap } from 'gsap'

  let cleanup = () => {}

  function setupScrollToTop() {
    cleanup()
    const container = document.getElementById('scroll-to-top')
    if (!container) return
    const button = container.querySelector<HTMLButtonElement>('button')
    if (!button) return

    const controller = new AbortController()
    const { signal } = controller
    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches

    let isVisible = false
    if (!reduced) gsap.set(container, { y: 8, scale: 0.96 })

    const isBelowViewport = () => {
      const minHeight = window.innerHeight * 0.4
      const scrollTop =
        document.documentElement.scrollTop || document.body.scrollTop
      return scrollTop > minHeight
    }

    const updateVisibility = () => {
      const shouldShow = isBelowViewport()
      if (shouldShow === isVisible) return
      isVisible = shouldShow

      if (reduced) {
        container.style.opacity = isVisible ? '1' : '0'
        container.style.pointerEvents = isVisible ? 'auto' : 'none'
        return
      }

      if (isVisible) {
        container.style.pointerEvents = 'auto'
        gsap.to(container, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.35,
          ease: 'power3.out',
          overwrite: 'auto'
        })
      } else {
        container.style.pointerEvents = 'none'
        gsap.to(container, {
          opacity: 0,
          y: 8,
          scale: 0.96,
          duration: 0.25,
          ease: 'power2.in',
          overwrite: 'auto'
        })
      }
    }

    button.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        })
      },
      { signal }
    )

    let frame = 0
    const scheduleVisibility = () => {
      if (frame) return
      frame = requestAnimationFrame(() => {
        frame = 0
        updateVisibility()
      })
    }

    window.addEventListener('scroll', scheduleVisibility, {
      passive: true,
      signal
    })
    updateVisibility()

    cleanup = () => {
      controller.abort()
      cancelAnimationFrame(frame)
      gsap.killTweensOf(container)
      gsap.killTweensOf(button)
    }
  }

  document.addEventListener('astro:page-load', setupScrollToTop)
  document.addEventListener('astro:before-swap', () => cleanup())
</script>
